{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "lemma.tags/1",
 "title": "Lemma タグ辞書",
 "type": "object",
 "required": [
  "schema",
  "tags"
 ],
 "properties": {
  "schema": {
   "const": "lemma.tags/1"
  },
  "tags": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "topic",
       "technique",
       "format"
      ]
     },
     "aliases": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
